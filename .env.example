# Copy to .env and adjust. .env is git-ignored — never commit real values.

# ---- Postgres ----
POSTGRES_USER=fleetops
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=fleetops

# ---- API ----
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__FleetOpsDb=Host=postgres;Port=5432;Database=fleetops;Username=fleetops;Password=change_me_locally

# JWT signing key. Must be >= 32 bytes. Generate with:
#   openssl rand -base64 48
Jwt__Key=REPLACE_WITH_openssl_rand_base64_48
Jwt__Issuer=fleetops-api
Jwt__Audience=fleetops-ui

# Password for the seeded demo accounts (admin / manager / analyst).
# Required by docker-compose; must be at least 8 characters.
DEMO_PASSWORD=fleetops-demo-2026

# ---- LocalStack (fake AWS, no real account or cost) ----
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=ca-central-1
AWS__ServiceUrl=http://localstack:4566
AWS__ManifestBucket=fleetops-manifests-upload-dev

# ---- Live AIS (optional) --------------------------------------------------
# Leave Ais__Enabled=false and the telemetry simulator runs instead, so the stack
# works with no credentials at all.
#
# To use real vessel traffic: sign in at https://aisstream.io/authenticate with GitHub,
# create a key at https://aisstream.io/apikeys, and paste it below. The service is free
# with no paid tier. Your key stays in .env, which is git-ignored — never commit it.
#
# Only navigation data is real. Engine temperature, RPM and fuel flow are derived from
# speed over ground; AIS does not broadcast them. See docs/adr/0006.
Ais__Enabled=false
Ais__ApiKey=
