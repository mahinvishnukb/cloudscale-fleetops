# Normalise line endings so the repo is identical on macOS, Linux and Windows.
* text=auto eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary

# Generated: keep it out of diffs and language statistics.
frontend/package-lock.json linguist-generated=true -diff
backend/src/FleetOps.Infrastructure/Persistence/Migrations/* linguist-generated=true

# Shell scripts must stay LF even on Windows checkouts, or they will not run.
*.sh text eol=lf
