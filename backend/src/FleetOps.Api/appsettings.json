{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "FleetOpsDb": ""
  },
  "Jwt": {
    "Key": "",
    "Issuer": "fleetops-api",
    "Audience": "fleetops-ui",
    "LifetimeMinutes": 60
  },
  "AWS": {
    "ServiceUrl": "",
    "Region": "ca-central-1",
    "ManifestBucket": "fleetops-manifests-upload-dev",
    "ForcePathStyle": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:4200"
    ]
  },
  "Database": {
    "MigrateOnStartup": true,
    "SeedDemoData": false,
    "DemoPassword": ""
  },
  "Swagger": {
    "Enabled": false
  },
  "Telemetry": {
    "Simulator": {
      "Enabled": false,
      "IntervalSeconds": 10,
      "AnomalyEveryNTicks": 12
    },
    "Thresholds": {
      "EngineTempWarningC": 85,
      "EngineTempCriticalC": 95,
      "ImplausibleSpeedKn": 45,
      "MinimumSpeedForFuelRuleKn": 3.0,
      "FuelPerNauticalMileWarning": 120,
      "FuelPerNauticalMileCritical": 200,
      "PositionJumpImpliedSpeedKn": 60,
      "SensorDropout": "00:15:00"
    }
  },
  "AllowedHosts": "*",
  "Ais": {
    "Enabled": false,
    "ApiKey": "",
    "Endpoint": "wss://stream.aisstream.io/v0/stream",
    "MaxTrackedVessels": 40,
    "MinimumSecondsBetweenReadings": 30,
    "BoundingBoxes": [
      {
        "South": 43.4,
        "West": -64.5,
        "North": 45.2,
        "East": -62.5
      }
    ]
  }
}